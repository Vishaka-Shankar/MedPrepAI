# ==== MedPrep AI - copy to .env and fill in. .env is git-ignored. ====

# --- Database (MongoDB Atlas) ---
# Atlas > Connect > Drivers. Put the database name before the "?", e.g. /medprep?
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/medprep?retryWrites=true&w=majority

# --- Backend (NestJS) ---
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# --- First admin account (backend: npm run db:seed-admin) ---
# Created with the email already verified. Password: 8-72 characters with a letter and a number.
# If an account with ADMIN_EMAIL exists, it is made an admin and keeps its own password.
ADMIN_NAME=MedPrep Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-123

# --- Frontend (React; only VITE_* variables reach the browser) ---
VITE_API_URL=http://localhost:3000
# true = the Chat page shows fake answers (works only with `npm run dev`, never in a build).
# Or just run `npm run dev:mock` in frontend/.
VITE_USE_MOCK=false

# --- RAG service ---
RAG_SERVICE_URL=http://localhost:8000
# Q&A service (rag-service/app): a question is answered only if its best chunk scores at least
# SIMILARITY_THRESHOLD (0-1); chunks more than RETRIEVAL_MARGIN below the best are dropped.
SIMILARITY_THRESHOLD=0.80
RETRIEVAL_MARGIN=0.05
# The only origin the Q&A service accepts (the NestJS backend). Empty = http://localhost:PORT
BACKEND_ORIGIN=
# groq | ollama
LLM_PROVIDER=groq
GROQ_API_KEY=
# Groq retired llama-3.1-8b-instant (HTTP 404 since 2026-10-29); the Qwen family is in the proposal
GROQ_MODEL=qwen/qwen3.8-27b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Ingestion pipeline (rag-service/ingest.py) ---
# OCR settings for scanned pages (TESSERACT_CMD above)
OCR_LANG=eng
OCR_DPI=300
# Tesseract page mode: 4 = one column of text (best on our phone-scanned textbooks)
OCR_PSM=4
# A text layer with fewer letters than this may hold only a footer or figure labels,
# so the page is also OCR'd and the OCR text is kept if it has clearly more text
TEXT_LAYER_MIN_LETTERS=800
# PDFs are read from DATA_RAW_DIR/<biology|chemistry|physics>/ (relative to the repo root)
DATA_RAW_DIR=data/raw
# Embedding model (rag-service/config.py has the full list):
#   BAAI/bge-small-en-v1.5  384 dims, field embedding384, index chunk_vector_index_384 (default; ~130 MB, light on RAM)
#   BAAI/bge-m3             1024 dims, field embedding, index chunk_vector_index (~2.3 GB RAM; stronger machines)
# The dimensions, field, index and model folder follow from the name; leave EMBED_MODEL_DIR empty for
# the default folder (rag-service/models/<model>). EMBED_DIM is optional: if set it must match the model.
EMBED_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBED_MODEL_DIR=
EMBED_DIM=384
# Small batches and few CPU threads keep RAM low on a laptop without a GPU
EMBED_BATCH=8
EMBED_THREADS=2
# Optional: tokens the model reads per chunk (default and maximum: 512 for bge-small, 1024 for BGE-M3)
EMBED_MAX_LENGTH=
# Chunk size and overlap in the model's tokens (CHUNK_SIZE must be at most EMBED_MAX_LENGTH - 2)
CHUNK_SIZE=500
CHUNK_OVERLAP=75

# --- Email (OTP verification codes), see README "Email setup" ---
# Gmail: smtp.gmail.com, port 587, your Gmail address, and an App Password (needs 2-Step Verification).
# Development: Mailtrap or Ethereal SMTP settings (emails are caught, never delivered).
# Without SMTP_HOST the app still starts, but registration answers 503 "Couldn't send the email".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional; defaults to "MedPrep AI <SMTP_USER>" (Gmail only allows sending as the account itself)
MAIL_FROM=
